# StratFolio app — local environment.
#
#   cp .env.example .env && npm run dev
#
# Every domain defaults to `mock`. The scripted demo is a supported product
# mode (D2), so nothing here degrades a live domain back to mock at runtime:
# a live domain with a dead backend shows an error, not fabricated data.
#
# Backends must be running for a `live` domain to work — see plan §8:
#   (cd ../stratfolio && make up)
#   (cd ../stratfolio/service-plt && make run)   # :7201
#   (cd ../stratfolio/service-bkt && make run)   # :7401
#   (cd ../stratfolio/service-ai  && make run)   # :7301 (binds 127.0.0.1)
#   (cd ../stratfolio/service-mnd && make run)   # :7101 gRPC / :7102 HTTP mux

# --- Per-domain data source (D2): `mock` (default) or `live` -----------------

# plt portfolio, positions, activity, order history, settled-equity curve
# (Wave A, APP-102) plus the open path — plt trade plan → bkt execution
# (Wave B, APP-112). Opening also needs VITE_DATA_MARKET=live: the ticket
# selects a real contract off the chain, and bkt refuses a plan whose contract
# it cannot re-resolve.
#
# Closing by hand is live too (APP-114): bkt's user-exit route prices the
# close itself from the current quote and records the reason as USER_CLOSE.
# The ticket sends a trade id and an idempotency key — nothing else.
#
# This flag also binds the three execution-policy settings (contracts §16) to
# plt's user_config: the master AI-trading switch, approval mode and trading
# window are read from and written to the platform, and enforced there — the
# switch stops AI execution server-side. In mock mode they stay device-local
# and the settings screen says so.
VITE_DATA_PORTFOLIO=mock

# The plt ActiveUniverse surface (watchlist API). Wave A (APP-103).
VITE_DATA_UNIVERSE=mock

# Market data over the mnd :7102 JSON facade (contracts §15) — quotes, bars,
# chains, market status, and the real chain marks behind unrealized P&L.
# Wave B0 (APP-108). Requires service-mnd with its HTTP mux on :7102.
#
# In replay mode the clock is the dataset's, not the wall clock: bar windows
# and day-change baselines are anchored to `GET /api/v1/market/status`. A
# symbol the dataset does not serve simply never appears in the tape — nothing
# is synthesised to fill the gap, and neither the terminal chain nor the
# in-browser IV/OI model runs in live mode.
VITE_DATA_MARKET=mock

# Theses over plt `GET /api/v1/theses` (APP-111, Wave B).
#
# A live thesis carries exactly what plt records — rationale, direction,
# confidence (a 0..1 fraction), evidence, invalidation conditions, expected
# catalyst and horizon — and no price, entry band, target band or
# recommendation, because plt has no such field. The rich thesis tiles are
# demo content and render only in mock mode.
VITE_DATA_IDEAS=mock

# Trade plans over plt `GET/POST /api/v1/trade-plans` (APP-113, Wave B).
#
# Reads and creation are live. A live plan carries a contract, an entry band
# (`target_entry_min/max` — the one criterion PolicyGate really checks) and
# *fractional* exits; it carries no title, no author, no target band and no
# absolute stop, because plt has no such field. Editing, disabling and
# deleting have no plt route at all (HKP-PLT-4): the app records those
# locally plus as a schema-valid USER_ACTIVITY row.
VITE_DATA_PLANNER=mock

# News. BLOCKED on HKP-MND-2 (no browser-reachable news) — leave on mock.
VITE_DATA_NEWS=mock

# Assistant/chat. BLOCKED on HKP-AI-2 (service-ai has no chat routes at all,
# only the tables) — leave on mock.
VITE_DATA_ASSISTANT=mock

# --- Transport ---------------------------------------------------------------

# Request timeout in milliseconds. bkt backtests are 202-but-synchronous
# (§7.6) and pass their own, much longer budget explicitly.
VITE_API_TIMEOUT_MS=15000

# --- Market data tuning (only meaningful with VITE_DATA_MARKET=live) ---------

# Symbols the quote provider polls, comma separated. This is a *request* list,
# not data: one the dataset does not serve never renders.
#
# MUST MATCH THE ACTIVE DATASET OR PROVIDER. The default is mnd's
# `synthetic-v1` replay dataset, which serves SPY, AAPL and MSFT and nothing
# else — QQQ and NVDA answer 404/503 there. Running against another dataset or
# a live provider means overriding this to match, or every poll spends
# requests on symbols that can only fail.
# VITE_MARKET_SYMBOLS=SPY,AAPL,MSFT

# Quote poll cadence, ms (default 5000; only while the tab is visible).
# VITE_MARKET_QUOTE_POLL_MS=5000

# Chain/summary poll cadence, ms (default 60000). Deliberately far slower than
# quotes: a chain request is orders of magnitude more expensive (D8).
# VITE_MARKET_CHAIN_POLL_MS=60000

# Same-origin service prefixes. Override only when fronting the services with
# a reverse proxy that mounts them elsewhere; they are never absolute URLs in
# dev, because no service sends CORS headers (HKP-CORS-1).
# VITE_PLT_BASE=/plt
# VITE_AI_BASE=/ai
# VITE_BKT_BASE=/bkt
# VITE_MND_BASE=/mnd
